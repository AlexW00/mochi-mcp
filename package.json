{
  "name": "mochi-mcp",
  "version": "1.0.0",
  "description": "Rate-limit-aware MCP server for Mochi Cards with batch jobs, Streamable HTTP and OAuth",
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexW00/mochi-mcp.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mochi-mcp": "dist/src/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/http.js",
    "start:stdio": "node dist/src/stdio.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "keywords": [
    "mcp",
    "mochi",
    "flashcards",
    "spaced-repetition"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
